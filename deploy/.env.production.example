GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=/var/www/churchbridge-ai/secrets/google-speech-service-account.json
GOOGLE_CLOUD_LOCATION=us
GOOGLE_SPEECH_MODEL=chirp_3
GOOGLE_SPEECH_LANGUAGE=es-US
GOOGLE_SPEECH_RECOGNIZER=_
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///./data/churchbridge.db
PORT=8000
ENVIRONMENT=production
NEXT_PUBLIC_API_URL=https://churchbridge.dhaines.dev
